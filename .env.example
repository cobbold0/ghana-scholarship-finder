# Public site URL used for canonical URLs, sitemap and robots (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Analytics loads only when set.
NEXT_PUBLIC_GA_ID=

# Optional: Google AdSense. Ads render only when both are set.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
